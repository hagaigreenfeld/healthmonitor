{
  "hosting": [
    {
      "site": "healthmonitor-405cc",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        ".claude/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "health-monitorings",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        ".claude/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
